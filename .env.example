# ── OpenInvoice Germany — Beispiel-Umgebung ──────────────────────────────
# Kopiere diese Datei nach .env und passe die Werte an.

# Datenbank ---------------------------------------------------------------
# Solo/Dev (Default): lokale SQLite-Datei, kein Server nötig.
DATABASE_URL="file:./dev.db"
#
# Postgres (Docker/Prod): siehe docker-compose.yml + prisma/schema.postgres.prisma
# DATABASE_URL="postgresql://oig:oig@localhost:5432/openinvoice?schema=public"

# Anmeldung ---------------------------------------------------------------
# Signiert die Session-Cookies UND dient als Schlüssel für verschlüsselt gespeicherte
# SMTP-Passwörter (Einstellungen → E-Mail-Versand). In PRODUKTION zwingend mit starkem
# Zufallswert setzen:
#   openssl rand -base64 32
# Ein späterer Wechsel invalidiert das gespeicherte SMTP-Passwort — danach in den
# Mail-Einstellungen neu eintragen. Verschlüsselt außerdem die Angebotslink-Token
# (QuoteShareLink.tokenEnc) für den Betreiber-Wiederabruf ("Link anzeigen"); ein
# Wechsel macht bestehende Links dort unlesbar (die Online-Annahme selbst bleibt
# funktionsfähig, da dafür nur der SHA-256-Hash gebraucht wird). Verschlüsselt
# außerdem die Webhook-Endpunkt-Secrets (WebhookEndpoint.secretEnc, Phase 10) — ein
# Wechsel macht bestehende Webhook-Secrets unlesbar, betroffene Endpunkte müssen
# ihr Secret dann neu rotieren (Einstellungen → Webhooks).
AUTH_SECRET=""

# Session-Cookie Secure-Flag (optional) ------------------------------------
# Standard: Secure nur, wenn der Reverse-Proxy "x-forwarded-proto: https" sendet.
# Direkter HTTP-Zugriff (z. B. npm start im LAN ohne TLS) bekommt kein Secure-Flag,
# sonst verwirft der Browser das Cookie (Login-Schleife). Hinter HTTPS-Proxy ohne
# X-Forwarded-Proto: SESSION_COOKIE_SECURE=true setzen.
# SESSION_COOKIE_SECURE=true

# Basis-URL -----------------------------------------------------------------
# PFLICHT fuer Passwort-Reset-Links: Der Link stammt immer aus APP_BASE_URL, nie aus
# Request-Headern (ohne die Variable ist der Reset nicht eingerichtet).
# Fuer den Angebotsannahme-Link (/angebot/<token>) optional: ohne sie wird die Basis-URL
# aus den Request-Headern rekonstruiert (x-forwarded-proto + host). In Produktion
# explizit setzen:
# APP_BASE_URL="https://rechnung.example.org"

# Client-IP fuer Rate-Limits (optional) -------------------------------------
# cf | x-real-ip | xff | legacy (Default). cf: nur cf-connecting-ip (hinter Cloudflare,
# Origin nur fuer Cloudflare-IPs erreichbar). x-real-ip: hinter nginx, der den Header
# selbst setzt. xff: Eintrag von rechts aus X-Forwarded-For, TRUSTED_PROXY_COUNT Proxys
# (Default 1). legacy: cf-connecting-ip, sonst erster XFF-Eintrag (faelschbar, wenn der
# Origin direkt erreichbar ist).
# CLIENT_IP_SOURCE=legacy
# TRUSTED_PROXY_COUNT=1

# Cron-Endpunkte (PFLICHT, wenn du /api/cron/* verwendest) ------------------
# Schützt GET/POST /api/cron/run-recurring, /api/cron/run-dunning, /api/cron/run-all.
# `/api/cron` ist bewusst NICHT sessiongeschützt (proxy.ts) — dieses Secret ist der
# einzige Schutz. Ohne gesetzten Wert antworten die Routen fail-closed mit 503 (Fix-Welle
# B3, vorher: ohne Secret anonym erreichbar). Der Aufruf muss
#   Authorization: Bearer <CRON_SECRET>   (oder ?secret=…)
# mitliefern. Für öffentliche Deployments zwingend setzen — sonst sind die Cron-Endpunkte
# schlicht gesperrt (nutzt du stattdessen nur den eingebauten Loop/`npm run scheduler:run`
# lokal, kannst du diese Variable leer lassen, dann bleiben nur die /api/cron-Routen tot).
CRON_SECRET=""

# Scheduler (Mahnwesen/Abos, Phase 6) ---------------------------------------
# Eingebauter Intervall-Loop im Node-Prozess (src/instrumentation.ts) — läuft zusätzlich zu
# den Cron-Endpunkten/CLI-Skripten (dieselbe Runner-Funktion, dasselbe SchedulerRun-Protokoll).
# Default AN (Opt-out, nicht Opt-in) — auf "false"/"0"/"no"/"off" setzen, um zu deaktivieren.
# SCHEDULER_ENABLED="true"
# Intervall in Minuten (Default 15, min. 1). Erster Lauf 60 s nach Prozessstart.
# SCHEDULER_INTERVAL_MINUTES="15"

# E-Rechnung-Validierung (optional) --------------------------------------
# Mustangproject-Sidecar (Docker) für XRechnung/ZUGFeRD-Erzeugung & -Validierung.
# Ohne diesen Dienst kann die App nur "sonstige Rechnungen" (PDF) ausstellen.
# EINVOICE_SERVICE_URL="http://localhost:8085"

# Beleganhaenge (optional) -------------------------------------------------
# Ablageverzeichnis fuer Datei-Anhaenge an Belegen (Phase 4b) — ausserhalb des
# Web-Roots. Default: ./data/attachments (relativ zum Prozessverzeichnis). Im
# Docker-Container: /app/data/attachments (Volume, siehe docker-compose.yml).
# ATTACHMENTS_DIR="./data/attachments"

# Belegarchiv (Phase 16a, GoBD) -----------------------------------------------
# Write-once-Ablage der ausgegebenen Rechnungsdateien (PDF, CII, UBL) — beim ersten
# Ausgabeweg nach dem Festschreiben eingefroren, danach nur noch von hier ausgeliefert
# (SHA-256-geprueft). Ausserhalb des Web-Roots, in die Datensicherung aufnehmen.
# Default: ./data/archive (relativ zum Prozessverzeichnis). Im Docker-Container:
# /app/data/archive (Volume oig-archive, siehe docker-compose.yml).
# ARCHIVE_DIR="./data/archive"
# Archiv-Nachlauf (Scheduler-Job "archive", alle 15 min): hoechstens so viele Belege je Lauf
# (1..200, Default 50). Kleiner setzen, um Lastspitzen beim ersten Backfill zu senken.
# ARCHIVE_JOB_BATCH=50

# E-Mail-Versand -----------------------------------------------------------
# Keine Umgebungsvariablen nötig: SMTP-Host, Port, Zugangsdaten und Absender werden
# unter Einstellungen → E-Mail-Versand konfiguriert (Passwort verschlüsselt in der
# Datenbank, siehe AUTH_SECRET oben). Siehe README, Abschnitt "E-Mail-Versand einrichten".

# Marke — Quellcode-Link der AGPL-Herkunftszeile (optional, Phase 12c) ------
# Ziel des "Quellcode"-Links in der stets sichtbaren Fusszeilen-Zeile "powered by
# OpenInvoice Germany · AGPL-3.0" (§13 AGPL-3.0, COMPLIANCE.md Abschnitt 19). Der
# Instanzname selbst ist unter Einstellungen → Marke ueberschreibbar, diese
# Herkunftszeile inkl. Link NICHT. Default: das oeffentliche Upstream-Repository.
# Betreibst du eine MODIFIZIERTE Version per Netzwerk, muss dieser Link nach §13
# AGPL-3.0 auf das oeffentlich erreichbare Repository mit deinem tatsaechlich
# laufenden (Fork-)Stand zeigen, nicht auf das unveraenderte Original.
# SOURCE_URL="https://github.com/automationsmanufaktur-labs/open-invoice-germany"

# Datensicherung (Phase 16a, Vorlage scripts/ops/backup.sh, siehe docs/BETRIEB-VORLAGE.md) --------
# Offsite-Ziel (optional): rsync:user@host:/pfad  oder  s3:bucket/prefix (aws oder rclone).
# BACKUP_TARGET=""
# Datei mit der Passphrase der Sicherung (Modus 600, ausserhalb des Repositories, getrennt verwahren).
# BACKUP_PASSPHRASE_FILE="/etc/oig/backup.pass"
# Anzahl lokaler Sicherungen / Aufbewahrung am Ziel in Tagen.
BACKUP_KEEP_LOCAL=30
BACKUP_KEEP_REMOTE=90
# Statusdatei: je Lauf eine Zeile "OK <ISO>" bzw. "FEHLER <ISO> <grund>"; GET /api/v1/System/health liest daraus.
# BACKUP_STATUS_FILE="/var/lib/oig/backup-status.txt"
# Optional: pg_dump im DB-Container ausfuehren (passende Serverversion), z. B. "open-invoice-germany-db-1".
# PG_DUMP_CONTAINER=""
# Restore-Test: Image des temporaeren Containers (passend zur pg_dump-Version) und Wartezeit in Sekunden.
# PG_IMAGE="postgres:16"
# RESTORE_READY_TIMEOUT=60

# Wechselkurse (Phase 16b) ----------------------------------------------------------------------
# Taeglicher Abruf der EZB-Referenzkurse durch den Scheduler-Job "fx" (ab 16:15 Berlin).
# "0" schaltet den Abruf ab (Kurse dann nur manuell pflegen).
# FX_AUTO_FETCH=1
